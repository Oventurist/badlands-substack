# raw corpus is huge and immutable; keep it out of git
raw/
articles/
transcripts/
posts-new/
unprocessed/
cache/
# hermes runtime
wiki/.processed.txt
wiki/.inprogress-*
# parallel-rebuild runtime state (not source content)
wiki/.quarantine.txt
wiki/.page-locks/
scripts/.parallel-ingest.lock
scripts/.failure-watchdog.state
scripts/.rate-limit-cooldown
# third-party scraper (re-clone: git clone https://github.com/<repo>/Substack2Markdown)
scripts/Substack2Markdown/
# Obsidian local config (window state, UI prefs — machine-local)
.obsidian/

# VitePress site (build artifacts + generated docs)
site/node_modules/
# lightweight static generator output
site/web/
site/public/
site/dist/
site/public/
site/dist/
# legacy VitePress output (no longer used)
site/docs/.vitepress/dist/
site/docs/entities/
site/docs/concepts/
site/docs/articles/
site/docs/tags/
site/docs/index.md
site/docs/.vitepress/config.mjs
site/docs/.vitepress/theme/
site/docs/public/
.tmp144/
.hermes/
